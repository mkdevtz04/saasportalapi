APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: https://wifikitaa.site . Routers download their setup command from this address,
# so it must be the real public domain. After editing it run: php artisan config:clear
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=captiveportalapi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


PALMPESA_BASE_URL=https://palmpesa.drmlelwa.co.tz
PALMPESA_API_KEY=
PALMPESA_USER_ID=

MIKROTIK_IP=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=admin
MIKROTIK_PORT=8728

# ── Local Relay Agent ────────────────────────────────────────────────────────
# Set to true when the router is on a private LAN the VPS cannot reach.
# The relay agent (mikrotik-agent.php) must be running on a machine that
# CAN reach the router's IP.
MIKROTIK_RELAY_ENABLED=false
MIKROTIK_RELAY_URL=http://192.168.88.250:8000
MIKROTIK_RELAY_SECRET=change-me-now

# ── Platform billing ─────────────────────────────────────────────────────────
# Percentage the platform keeps from every tenant withdrawal.
# Portal payments and voucher sales carry no fee.
PLATFORM_WITHDRAWAL_FEE_PCT=5

# Where the platform admin is texted when an ISP asks to withdraw, because the money only
# moves once a person approves it. Leave empty to rely on the admin panel alone.
PLATFORM_ALERT_PHONE=

# ── SMS ──────────────────────────────────────────────────────────────────────
# log (default, sends nothing), beem, or kilakona.
SMS_DRIVER=log
# The sender name recipients see. The provider has to register it first.
SMS_SENDER_ID=TRINETPAY

# Beem Africa
BEEM_API_KEY=
BEEM_SECRET=

# KilaKona. The address comes from their API reference in your dashboard: it has no default
# here, because sending to a guessed address would fail without saying why.
KILAKONA_API_KEY=
KILAKONA_API_SECRET=
KILAKONA_ENDPOINT=

# ── Router connectivity (FreeRADIUS) ─────────────────────────────────────────
# Public IPv4 address of the FreeRADIUS server and the shared secret set in its clients.conf.
# See deploy/freeradius/README.md. Routers cannot be set up until both are filled in.
RADIUS_HOST=
RADIUS_SECRET=
# How often a router checks in with the platform, and how long silence counts as offline.
ROUTER_AGENT_INTERVAL=1m
ROUTER_OFFLINE_AFTER=5
# Minutes of silence before the owner is emailed and texted about an offline router.
ROUTER_ALERT_AFTER=10

# ── Production checklist ─────────────────────────────────────────────────────
# APP_ENV=production            APP_DEBUG=false
# SESSION_SECURE_COOKIE=true    keeps the login cookie off plain HTTP
# QUEUE_CONNECTION=database     and run: php artisan queue:work (see deploy/DEPLOY.md)
# TRUSTED_PROXIES=              the proxy address, or * when behind nginx or Cloudflare
# HEALTH_TOKEN=                 any long random value, lets your uptime monitor read /health details
TRUSTED_PROXIES=
HEALTH_TOKEN=
